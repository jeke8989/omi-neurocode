{
  "schema": 1,
  "id": "github",
  "name": "GitHub Issues",
  "icon": "🐙",
  "version": "1.0.0",
  "author": "Neuro Codes",
  "description": "Задачи на разработку из разговоров становятся issues в вашем репозитории. Агент может создавать issues по просьбе.",
  "permissions": {"hosts": ["api.github.com"]},
  "settings": [
    {"key": "token", "title": "GitHub токен", "secret": true, "required": true,
     "hint": "Fine-grained token с правом Issues: Read and write для нужного репозитория"},
    {"key": "owner", "title": "Владелец (организация)", "secret": false, "required": true},
    {"key": "repo", "title": "Репозиторий", "secret": false, "required": true}
  ],
  "on_task": {
    "title": "Задачи на разработку → GitHub Issues",
    "only_target": "github",
    "http": {
      "method": "POST",
      "url": "https://api.github.com/repos/{settings.owner}/{settings.repo}/issues",
      "headers": {"Authorization": "Bearer {settings.token}", "Accept": "application/vnd.github+json"},
      "body": {"title": "{text}", "body": "Срок: {due}\nИсточник: {source}\nРазговор: {conversation}\n\nСоздано NeuroSoft"}
    }
  },
  "tools": [
    {
      "name": "create_issue",
      "title": "Создаю issue",
      "description": "Создать issue в GitHub-репозитории владельца.",
      "parameters": {"type": "object", "properties": {"title": {"type": "string"}, "body": {"type": "string"}}, "required": ["title"]},
      "http": {
        "method": "POST",
        "url": "https://api.github.com/repos/{settings.owner}/{settings.repo}/issues",
        "headers": {"Authorization": "Bearer {settings.token}", "Accept": "application/vnd.github+json"},
        "body": {"title": "{title}", "body": "{body}"}
      }
    }
  ]
}
