# ===== Mnemo: настройки сервера =====
# deploy.sh сам создаст .env из этого файла: пароль БД и ключ доступа сгенерирует случайные.
# Модели для каждой задачи выбираются в приложении: Настройки → Модели ИИ.

# Ключ OpenRouter — один на всё: агент, распознавание речи, поиск, дневник, фото
OPENROUTER_API_KEY=

# Ключ доступа приложения. Приложение получает его по одноразовому коду (deploy.sh печатает код в конце)
API_TOKEN=
POSTGRES_PASSWORD=
# Порт на сервере, куда подключается приложение
GATEWAY_PORT=8090
# autoheal перезапускает зависшие контейнеры. Уже есть свой autoheal на сервере — оставьте пусто
COMPOSE_PROFILES=autoheal
TZ=Europe/Moscow

# ----- Расшифровка записи -----
# openrouter — Whisper Large v3 через OpenRouter (~$0.03 за час звука, рекомендую)
# whisper    — локально на сервере, бесплатно, но грузит процессор и хуже по-русски
# deepgram   — Deepgram напрямую (нужен DEEPGRAM_API_KEY, есть разделение по голосам)
STT_PROVIDER=openrouter
# Язык речи: пусто — как язык приложения (меняется в приложении), auto — определять автоматически, ru/en/tr/es
STT_LANGUAGE=
# Куски без речи (тишина, ровный шум в машине) не отправляются в распознавание: меньше N мс речи — пропуск. 0 — выключить
SPEECH_MIN_MS=300
WHISPER_MODEL=small
DEEPGRAM_API_KEY=

# ----- Разговоры, кнопка, голос -----
CONVERSATION_GAP_SEC=120
CONVERSATION_IDLE_SEC=180
REMEMBER_WINDOW_SEC=60
ASK_MAX_SEC=15
ASK_END_SILENCE_MS=1200
# Сколько секунд ждать ответа агента для озвучки; дольше — «ответ будет в чате»
VOICE_BUDGET_SEC=14
# Сколько дней хранить сырое аудио (расшифровки хранятся всегда). Это значение по умолчанию: в приложении
# Настройки -> Данные -> Звук записей можно выбрать срок или «Удалять после расшифровки»
KEEP_AUDIO_DAYS=3

# ----- Голоса (кто говорит) -----
# Отпечатки голосов считаются на этом сервере моделью WeSpeaker (~26 МБ, скачивается сама при первом запуске STT).
# Звук никуда не уходит. Включается и выключается в приложении: Люди -> Приватность.
SPEAKER_BACKEND=wespeaker
SPEAKER_THREADS=2
# Модель отпечатков: resnet152 точнее на коротких фразах (≈2 с процессора на 30 с записи); при смене модели
# люди пересчитываются сами по сохранённым записям голосов
SPEAKER_MODEL=wespeaker_en_voxceleb_resnet152_LM

# ----- Нейроголос ответов (Supertonic 3, бесплатно на сервере, ru/en/tr/es) -----
# Модель ~130 МБ скачивается сама при первом запуске. 0 — не загружать заранее
TTS_ENABLED=1
TTS_THREADS=2

# ----- Claude в чате (контейнер claude) -----
# Токен вводится в приложении (Настройки -> Claude Code), здесь не нужен. Можно поменять репозиторий и лимит:
# CLAUDE_REPO_URL=https://github.com/jeke8989/omi-neurocode.git
# CLAUDE_PUSH_URL=git@github.com:jeke8989/omi-neurocode.git
# CLAUDE_MAX_MIN=30

# ----- Маркетплейс расширений -----
# Встроенный каталог лежит в server/marketplace. Можно добавить внешний индекс:
MARKETPLACE_URL=

# ----- Экспорт задач -----
AUTO_EXPORT=false
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_TITLE_PROPERTY=Name
GITHUB_TOKEN=
GITHUB_REPO=

# Шифрование данных в базе (от утечек дампов и бэкапов): 32 байта в base64, например: openssl rand -base64 32
# Создаётся само при установке и обновлении. Без этого ключа зашифрованные данные не прочитать —
# храните копию .env отдельно от бэкапов базы.
DATA_KEY=
